#### create box plot of PCA####
# load ggplot2
library(ggplot2)
# load data in Rstudio with readr or other methods as needed
# plot boxplot with mean since boxplot already has median
boxplot1 <- ggplot(forboxplot_1720, aes(x = Breed, y = PC1, label = Breed)) +
  geom_boxplot(fill = "azure", color = "blue", width = 0.7) +  
  geom_jitter(position = position_jitter(0.2), color = "grey", size = 2, alpha = 0.5) +  # Add data points
  stat_summary(fun = mean, geom = "point", shape = 5, size = 2, color = "black", position = position_dodge(0.75)) +  # Add mean points
  labs( x = "Breeds", y = "First Principal Component") +
  theme_classic()+
  theme(
    axis.text.x = element_text(angle = 90, vjust = 0.5, hjust = 1, size = 18),  # Adjust x-axis font size
    axis.text.y = element_text(size = 16),  # Adjust y-axis font size
    axis.title = element_text(size = 16)  # Adjust title font size
  )

print(boxplot1)

ggsave("C:/Users/mahesh.neupane/Downloads/PC1Boxplot", plot = boxplot1, device = "png", width = 10, height = 6, units = "in", dpi =600)

